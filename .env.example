# Copie para .env (na raiz) e preencha. Nunca versione o .env.

# --- Banco (PostgreSQL 16 + PostGIS) ---
POSTGRES_DB=ignis
POSTGRES_USER=ignis
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432
# usado fora do Docker (rodar API/testes localmente); no Compose é montado automaticamente.
# Use 127.0.0.1, não localhost: no Windows, localhost tenta IPv6 primeiro e a conexão leva ~2 min.
DATABASE_URL=postgresql+psycopg://ignis:troque_esta_senha@127.0.0.1:5432/ignis

API_PORT=8000

# --- NASA FIRMS ---
# Chave gratuita registrada em https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=coloque_sua_chave_aqui
FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_SNPP_NRT,MODIS_NRT
COLLECT_INTERVAL_MINUTES=60
COLLECT_DAY_RANGE=2
MAX_COLLECTION_AGE_MINUTES=180

# --- FWI (GWIS/EFFIS, Copernicus) — sem chave; ver docs/fonte-fwi.md ---
FWI_INTERVAL_HOURS=12
# dias de previsão guardados além de hoje (o GWIS oferece até 9)
FWI_DAYS_AHEAD=3

# --- E-mail dos alertas (RF06) ---
# Chave geral, DESLIGADA por padrão: com false nada é enviado e a inscrição fica indisponível no portal,
# mesmo com SMTP_* preenchido. Os alertas continuam sendo gravados e aparecem no mapa.
# Para ativar: teste antes com `python -m ignis.notifications --to voce@x.com` (esse teste ignora a chave)
# e então troque para true.
EMAIL_ENABLED=false
# Não rode servidor SMTP próprio: use um relay (Amazon SES, Brevo, SMTP institucional...), porta 587.
# Sem SMTP_HOST e SMTP_FROM o envio fica desligado. Teste com: python -m ignis.notifications --to voce@x.com
# Dev local com Mailpit (docker compose --profile dev up -d mailpit; caixa de entrada em http://127.0.0.1:8025):
#   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_SECURITY=none  (sem usuário/senha)
# Amazon SES: SMTP_HOST=email-smtp.<regiao>.amazonaws.com, usuário/senha SMTP gerados no console do SES
# (não são as chaves de acesso da AWS) e SMTP_FROM com remetente/domínio verificado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465) ou none (só Mailpit)
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_FROM_NAME=IGNIS
SMTP_TIMEOUT_SECONDS=15

# --- Assinaturas e links dos e-mails (RNF04) ---
# Origem pública do portal: os links de confirmação/descadastro dos e-mails apontam para ela
# (ex.: https://ignis.exemplo.org). Sem isso, os links apontam para a API local.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Assina os links de descadastro (HMAC). 32+ caracteres; vazio = usa o JWT_SECRET. Trocar invalida links antigos.
SUBSCRIPTION_SECRET=
# versão do termo de privacidade gravada junto do consentimento; mude quando o texto mudar
TERMS_VERSION=2026-11
CONFIRM_TOKEN_HOURS=48

# --- Relatórios por IA (RF11) e boletim diário (RF07) ---
# Chave do Google AI Studio (https://aistudio.google.com/apikey). Fica só aqui, nunca no frontend.
# Sem LLM_API_KEY tudo continua funcionando: os boletins saem pelo template.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Confira no AI Studio qual modelo está na camada gratuita: nomes e limites mudam.
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=40
# boletim diário: hora UTC e regiões (slugs separados por vírgula). 1 região = 1 chamada por dia
BULLETIN_HOUR_UTC=7
BULLETIN_REGIONS=mediterraneo

# --- Área administrativa (RF09) ---
# Sem ADMIN_PASSWORD ou JWT_SECRET, o login responde 503 e /api/admin fica desligada.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha_de_admin
# >= 32 caracteres aleatórios, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio_de_32_ou_mais_caracteres
JWT_EXPIRE_MINUTES=480
